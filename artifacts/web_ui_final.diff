+/* ---------------------------------------------------- 交互反馈（chip / hover / 校验） */
+.chip-bar {
+  flex-basis: 100%;
+  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
+  padding-top: 8px;
+  border-top: 1px dashed var(--c-line);
+}
+.chip-bar[hidden] { display: none; }
+.chip-bar-label { color: var(--c-text-dim); font-size: var(--fs-sub); }
+.chip {
+  display: inline-flex; align-items: center; gap: 6px;
+  padding: 2px 6px 2px 10px;
+  border-radius: 20px;
+  border: 1px solid var(--c-line-strong);
+  background: rgba(79, 140, 255, 0.12);
+  color: var(--c-text);
+  font-size: var(--fs-sub);
+  transition: border-color .15s, background .15s;
+}
+.chip:hover { border-color: var(--c-primary); background: rgba(79, 140, 255, 0.2); }
+.chip-x {
+  border: 0; background: transparent; padding: 0 2px;
+  color: var(--c-text-2); font-size: 14px; line-height: 1; cursor: pointer; border-radius: 50%;
+}
+.chip-x:hover { color: var(--c-rose); }
+
+.panel { transition: border-color .15s, box-shadow .15s; }
+.panel:hover { border-color: var(--c-line-strong); }
+.panel.is-hover-linked { border-color: rgba(34, 211, 238, 0.55); box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.3), var(--shadow); }
+
+.kpi { transition: transform .15s, border-color .15s, box-shadow .15s; }
+.kpi:hover { transform: translateY(-2px); border-color: var(--c-primary); box-shadow: 0 6px 18px rgba(79, 140, 255, 0.22); }
+.chart-host { border-radius: 8px; transition: box-shadow .15s; }
+.chart-host:hover { box-shadow: inset 0 0 0 1px rgba(79, 140, 255, 0.22); }
+
+.drill-row { transition: color .15s, box-shadow .15s; }
+.drill-row.is-linked .drill-name { color: var(--c-cyan); }
+.drill-row.is-linked .drill-bar { box-shadow: 0 0 0 2px rgba(34, 211, 238, 0.55); }
+.risk-tag.is-linked { box-shadow: 0 0 0 2px var(--c-cyan); }
+
+.predict-form input.is-invalid { border-color: var(--c-rose); box-shadow: 0 0 0 2px rgba(251, 113, 133, 0.22); }
+.field-err { color: var(--c-rose); font-size: var(--fs-mono); }
+
